# TradingAgents-CN Environment Variable Configuration Example
# 🔐 Important: Copy this file to .env and fill in your actual API keys
# ⚠️  Warning: The .env file contains sensitive information; do NOT commit it to your Git repository
#
# 📋 Configuration Level Legend:
#   [REQUIRED]    - Required configuration; the system cannot start without it
#   [RECOMMENDED] - Recommended configuration; omitting it affects features but does not prevent startup
#   [OPTIONAL]    - Optional configuration; used for advanced features or performance tuning
#
# 📖 Detailed configuration guide: docs/configuration_guide.md

# ==================== Required Configuration (Mandatory for System Startup) ====================

# [REQUIRED] MongoDB Database Connection
# Used to store stock data, analysis results, user information, etc.
# ⚠️ Important: Following the P1-5 security upgrade, a complete connection string must be set
# Format: mongodb://username:password@host:port/database?authSource=admin
# 🔐 You MUST change the admin password in production! Generate one via: openssl rand -base64 24
MONGODB_CONNECTION_STRING=mongodb://admin:PLEASE_CHANGE_MONGO_PASSWORD@localhost:27017/tradingagents?authSource=admin
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_USERNAME=admin
MONGODB_PASSWORD=PLEASE_CHANGE_MONGO_PASSWORD
MONGODB_DATABASE=tradingagents
MONGODB_AUTH_SOURCE=admin

# [REQUIRED] Redis Cache Connection
# Used for caching, session management, real-time notifications, etc.
# 🔐 You MUST set a Redis password in production! Generate one via: openssl rand -base64 24
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=PLEASE_CHANGE_REDIS_PASSWORD
REDIS_DB=0

# [REQUIRED] JWT Security Configuration
# Used to generate and verify user authentication tokens
# ⚠️ In production, be sure to change this to a random string (at least 32 characters)
# Generate via: python -c "import secrets; print(secrets.token_urlsafe(32))"
#               or openssl rand -base64 48
# 🚫 Do NOT use this default value in production, otherwise the system will refuse to start when DEBUG is false
JWT_SECRET=PLEASE_CHANGE_JWT_SECRET_USE_openssl_rand_base64_48
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# [REQUIRED] Administrator Default Password
# ⚠️ Security warning: A password must be specified when creating the administrator user
# In production, be sure to change this to a strong password (at least 8 characters, 16+ recommended)
ADMIN_DEFAULT_PASSWORD=PLEASE_CHANGE_ADMIN_PASSWORD

# [REQUIRED] CSRF Protection
# Used to prevent Cross-Site Request Forgery attacks
# ⚠️ In production, be sure to change this to a random string
# Generate via: openssl rand -base64 48
# 🚫 Do NOT use this default value in production, otherwise the system will refuse to start when DEBUG is false
CSRF_SECRET=PLEASE_CHANGE_CSRF_SECRET_USE_openssl_rand_base64_48

# [OPTIONAL] Proxy Configuration
# If you use a proxy to access overseas services (e.g., Google AI) but need direct connections to domestic data sources (e.g., Eastmoney),
# configure the NO_PROXY environment variable so domestic domains bypass the proxy.
# Separate multiple domains with commas.
# ⚠️ Windows does not support wildcard *; full domain names must be used.
# Detailed guide: docs/proxy_configuration.md
#HTTP_PROXY=http://127.0.0.1:7890
#HTTPS_PROXY=http://127.0.0.1:7890
NO_PROXY=localhost,127.0.0.1,eastmoney.com,push2.eastmoney.com,82.push2.eastmoney.com,82.push2delay.eastmoney.com,gtimg.cn,sinaimg.cn,api.tushare.pro,baostock.com

# [OPTIONAL] Update Check Service URL
# API base URL for checking updates and downloading update packages; can be set to a test domain during testing.
# Leave blank or commented out to use the default official URL: https://www.tradingagentscn.com/api
#UPDATE_CHECK_BASE_URL=https://www.tradingagentscn.com/api
# [OPTIONAL] Update Channel
# stable=production channel, test=testing channel; legacy values such as formal/prod/testing/beta are normalized automatically
#UPDATE_CHECK_CHANNEL=stable

# ==================== Recommended Configuration (For Normal Feature Operation) ====================

# [RECOMMENDED] LLM API Keys (Configure at least one)
# Used for AI analysis features; DeepSeek (high cost-efficiency) or DashScope/Qwen (stable domestic service) is recommended

# 🚀 DeepSeek V3 API Key (Recommended, very cost-effective)
# Get it at: https://platform.deepseek.com/
# Steps: Register an account -> Create API Key -> Copy key
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_ENABLED=false

# 🇨🇳 Alibaba Bailian (DashScope) API Key (Recommended, stable domestic service)
# Get it at: https://dashscope.aliyun.com/
# Steps: Register an Alibaba Cloud account -> Activate Model Studio (Bailian) -> Obtain API Key
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# [RECOMMENDED] Data Source Configuration
# Used to fetch stock market data; AKShare (free, no key required) or Tushare (professional data) is recommended

# 🎯 Default China Stock Data Source (akshare recommended)
# Options: akshare, tushare, baostock
DEFAULT_CHINA_DATA_SOURCE=akshare

# 🔍 SearXNG Web Search Configuration
# Leave blank to use default public instances (free, no Docker deployment required)
# Custom instances: separate multiple URLs with commas, e.g., https://my-searxng.local,https://search.sapti.me
# Available public instances list: https://searx.space
SEARXNG_INSTANCES=

# 📈 Tushare API Token (Recommended, professional A-share data)
# Get it at: https://tushare.pro/weborder/#/login?reg=tacn
# Steps: Register an account -> Verify email -> Obtain Token
# Note: Free accounts have rate limits; upgrading to 2000+ points is recommended, and real-time quotes require a separate subscription
TUSHARE_TOKEN=your_tushare_token_here
TUSHARE_ENABLED=false

# 📊 FinnHub API Key (Recommended, US stock data)
# Get it at: https://finnhub.io/
# Free tier allows 60 requests per minute
FINNHUB_API_KEY=your_finnhub_api_key_here

# ==================== Optional Configuration (Advanced Features) ====================

# [OPTIONAL] Other LLM API Keys
# Configure as needed to access additional AI models

# 🇨🇳 SiliconFlow API Key (Optional)
# Get it at: https://www.siliconflow.cn/
SILICONFLOW_API_KEY=your_siliconflow_api_key_here

# 🌍 OpenAI API Key (Optional, requires international network access)
# Get it at: https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here

# ==================== Aggregator Channel API Keys (Recommended) ====================
# Aggregator channels allow access to multiple first-party models via a single API Key, simplifying configuration and management
# Detailed documentation: docs/AGGREGATOR_SUPPORT.md

# 🌐 302.AI API Key (Recommended, domestic aggregator platform)
# Get it at: https://share.302.ai/DUjftK
# Steps: Register an account -> API Management -> Create API Key
# Features:
#   - Stable access in mainland China without a proxy
#   - Supports models from OpenAI, Anthropic, Google, DeepSeek, and more
#   - Unified billing with transparent pricing
# Format: sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Model format: openai/gpt-4, anthropic/claude-3-sonnet, google/gemini-pro
# Usage:
#   1. Initialize aggregator channels in the system (Settings -> Configuration Management -> Initialize Aggregator Channels)
#   2. Configure this API Key
#   3. Add models to the catalog (e.g., openai/gpt-4)
#   4. Select and use them in analyses
AI302_API_KEY=your_302ai_api_key_here

# 🌐 AIHubMix API Key (Optional, aggregator platform)
# Get it at: https://aihubmix.com/?aff=2rIi
# Documentation: https://docs.aihubmix.com/cn/quick-start
# Features:
#   - Provides a unified OpenAI-compatible interface
#   - Supports models from OpenAI, Anthropic, Google, DeepSeek, Qwen, and more
#   - Ideal for unified management and switching across multiple models
# Usage:
#   1. Add or initialize the AIHubMix provider in the system
#   2. Configure this API Key
#   3. Use https://aihubmix.com/v1 directly as the Base URL
AIHUBMIX_API_KEY=your_aihubmix_api_key_here
AIHUBMIX_BASE_URL=https://aihubmix.com/v1

# 🌐 OpenRouter API Key (Optional, international aggregator platform)
# Get it at: https://openrouter.ai/
# Features:
#   - Supports 50+ models, including free models
#   - Comprehensive coverage of mainstream international models
#   - Requires international network access
# Format: sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Model format: openai/gpt-4-turbo, anthropic/claude-3-opus, meta-llama/llama-3-70b
# Usage:
#   Option 1 (Recommended): Set the dedicated OPENROUTER_API_KEY
#   Option 2: If only using OpenRouter, you can set OPENAI_API_KEY to your OpenRouter key
OPENROUTER_API_KEY=your_openrouter_api_key_here

# 🔧 One API / New API (Optional, self-hosted aggregator platform)
# Repositories:
#   - One API: https://github.com/songquanpeng/one-api
#   - New API: https://github.com/Calcium-Ion/new-api
# Features:
#   - Open-source self-hosted solution
#   - Full control over data and costs
#   - Supports multi-model and multi-channel management
# Usage:
#   1. Self-host a One API / New API service
#   2. Create an API Key in your deployed service
#   3. Configure this API Key and Base URL
#   4. Model names typically do not require prefixes: gpt-4, claude-3-sonnet
ONEAPI_API_KEY=your_oneapi_api_key_here
ONEAPI_BASE_URL=http://localhost:3000/v1


# [OPTIONAL] Backtest Service URL (Conversation-driven backtesting, isolated GPLv3 container)
# Invoked via HTTP by the main platform; defaults to http://localhost:8900
# Start the backtest service using: docker-compose --profile backtest
# BACKTEST_SERVICE_URL=http://localhost:8900
BACKTEST_SERVICE_URL=http://localhost:8900

# Volcengine Ark
# Get it at: https://www.volcengine.com/solutions/ark
VOLCENGINE_API_KEY=your_volcengine_api_key_here
VOLCENGINE_CODING_API_KEY=your_volcengine_coding_api_key_here

# ==================== First-Party Provider API Keys (Optional) ====================

# 🔍 Google AI API Key (Optional, for Gemini models)
# Get it at: https://ai.google.dev/
GOOGLE_API_KEY=your_google_api_key_here

# 🤖 Anthropic API Key (Optional, for Claude models)
# Get it at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 🚀 DeepSeek V3 API Key (Recommended, highly cost-effective LLM)
# Get it at: https://platform.deepseek.com/
# Steps:
# 1. Register a DeepSeek account -> Log in to the console
# 2. Go to the API Keys page -> Create a new API Key
# 3. Copy the API Key (format: sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_ENABLED=false
# Note: Multiple boolean formats are supported (true/True/TRUE/1/yes/on to enable)

# 🔧 Other OpenAI-Compatible Provider API Keys (Optional)
# Generic template for adding any OpenAI-compatible LLM provider
# Contributors can use this template to add API keys for new providers
# Replace YOUR_PROVIDER with the actual provider name (e.g., MOONSHOT, ZHIPU, etc.)
# YOUR_PROVIDER_API_KEY=your_provider_api_key_here
# YOUR_PROVIDER_BASE_URL=https://api.yourprovider.com

# ERNIE Bot (Baidu Qianfan) API Key (OpenAI-compatible mode, typically starts with bce-v3/)
QIANFAN_API_KEY=your_qianfan_api_key_here
# Optional: If using the native Qianfan SDK/scripts (non-OpenAI-compatible path), see examples in scripts/
# QIANFAN_ACCESS_KEY=your_access_key
# QIANFAN_SECRET_KEY=your_secret_key


# Generic OpenAI-compatible provider API Key (for custom endpoints)
CUSTOM_OPENAI_API_KEY=your-custom-openai-api-key

# ===== Project Configuration =====

# Results storage directory
TRADINGAGENTS_RESULTS_DIR=./results

# Data storage directory (optional, defaults to ./data)
TRADINGAGENTS_DATA_DIR=./data

# Cache storage directory (optional, defaults to ./cache)
TRADINGAGENTS_CACHE_DIR=./cache

# Log level (DEBUG, INFO, WARNING, ERROR)
TRADINGAGENTS_LOG_LEVEL=INFO

# Disable Python bytecode generation (optional, for development environments)
PYTHONDONTWRITEBYTECODE=1

# ===== Memory and Cache Configuration =====

# 🧠 Memory feature toggle (enabled by default)
# Set to false to disable ChromaDB memory features and work around Windows 10 compatibility issues
# Recommended to set to false for Windows 10 users
MEMORY_ENABLED=true

# 💾 Cache strategy configuration (integrated recommended)
# Options:
#   - integrated: Integrated cache (recommended) - Automatically selects MongoDB/Redis/File for optimal performance
#   - file: File cache - Simple and stable, no external service dependencies
#   - adaptive: Adaptive cache - Same as integrated
# Notes:
#   - The integrated strategy prioritizes MongoDB and Redis caching for better performance
#   - Automatically falls back to file cache if MongoDB/Redis is unavailable
#   - File cache is stored locally only and is not synced to the database
TA_CACHE_STRATEGY=integrated

# 🔧 Maximum worker threads (optional, defaults to CPU core count)
# Windows 10 users are advised to set a smaller value, such as 2 or 4
# MAX_WORKERS=4

# ===== Database Configuration =====
# Set to true to enable the corresponding database; set to false or leave unset to disable
MONGODB_ENABLED=true
REDIS_ENABLED=true

# ===== Portfolio Analysis & Trade Review Enhancements (P0 Canary) =====
# Enable prompt generation via the template system (disabled by default, uses hardcoded prompts)
# When set to true, portfolio analysis and trade review use templates stored in the database
USE_TEMPLATE_PROMPTS=false

# Enable the v2 analysis engine (disabled by default, uses legacy simple_analysis_service)
# When set to true:
#   - Portfolio analysis runs 4 specialized agents in parallel via Workflow Engine v2.0
#     (Portfolio Technical Analyst, Portfolio Fundamental Analyst, Portfolio Risk Assessor, Portfolio Action Advisor)
#   - Trade review uses a multi-agent workflow for multi-dimensional analysis (timing/sizing/sentiment/attribution)
#   - Supports aggressive/neutral/conservative analysis styles, automatically selected based on user risk preference
USE_STOCK_ENGINE=false

# ===== Reddit API Configuration (Optional) =====
# Used to fetch social media sentiment data
# Get it at: https://www.reddit.com/prefs/apps

# Reddit Client ID
REDDIT_CLIENT_ID=your_reddit_client_id

# Reddit Client Secret
REDDIT_CLIENT_SECRET=your_reddit_client_secret

# Reddit User Agent
REDDIT_USER_AGENT=TradingAgents-CN/1.0

# ===== Usage Statistics and Cost Tracking Configuration =====

# 🔧 Token usage tracking toggle (enabled by default)
ENABLE_COST_TRACKING=true

# 💰 Cost alert threshold (in CNY, defaults to 100.0)
COST_ALERT_THRESHOLD=100.0

# 📊 Maximum number of usage records (defaults to 10000)
MAX_USAGE_RECORDS=10000

# 🗄️ Store token usage statistics in MongoDB (recommended for production)
# Set to true to enable MongoDB storage, or false to use JSON file storage
USE_MONGODB_STORAGE=true

# ⚠️ Note: MONGODB_CONNECTION_STRING is now a required configuration (P1-5 security upgrade)
# If not set, the system will raise a ValueError on startup
# Please use the full connection string configuration in the [REQUIRED] section above

# MongoDB connection string (optional override; automatically constructed from MONGODB_HOST etc. if omitted)
# MONGODB_CONNECTION_STRING=mongodb://admin:PLEASE_CHANGE_MONGO_PASSWORD@localhost:27017/

# MongoDB database name (optional, defaults to the value of MONGODB_DATABASE)
# MONGODB_DATABASE_NAME=tradingagents

# ===== Usage Instructions =====
# 1. Copy this file to .env: cp .env.example .env
# 2. Edit the .env file and fill in your actual API keys
# 3. Required: At least one AI model API key (DeepSeek or DASHSCOPE_API_KEY recommended)
# 4. Recommended: TUSHARE_TOKEN (for A-share data) and FINNHUB_API_KEY (for US stock data)
# 5. Run python -m cli.main config to check configuration status
# 6. Run python -m cli.main test to verify whether the configuration is working properly
#
# ===== Where to Obtain API Keys =====
# - DeepSeek (Recommended, high cost-efficiency): https://platform.deepseek.com/
# - DashScope / Qwen (Stable domestic service): https://dashscope.aliyun.com/
# - OpenAI (Powerful capabilities): https://platform.openai.com/
# - Google Gemini (Generous free tier): https://aistudio.google.com/
# - Tushare (A-share market data): https://tushare.pro/
# - FinnHub (US stock market data): https://finnhub.io/
#
# ===== Added in v0.1.16 =====
# 🚀 API Service Configuration (The three keys below are legacy and deprecated but remain compatible; use HOST/PORT/DEBUG below instead)
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# 🔗 CORS Configuration
# ⚠️ Do NOT use ["*"] in production, otherwise the service will refuse to start
# List your actual frontend domain(s), e.g., ["https://your-domain.com"]
ALLOWED_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173", "http://127.0.0.1:3000"]
ALLOWED_HOSTS=["*"]

# 🔐 Security Configuration
# ⚠️ In non-DEBUG mode, leaving the secrets below at their default values will prevent the service from starting!
# Generate via: python -c "import secrets; print(secrets.token_urlsafe(32))"
#               or openssl rand -base64 48
JWT_SECRET=PLEASE_CHANGE_JWT_SECRET_USE_openssl_rand_base64_48
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# CSRF Protection
# ⚠️ In production, be sure to change this to a random string
# Generate via: openssl rand -base64 48
CSRF_SECRET=PLEASE_CHANGE_CSRF_SECRET_USE_openssl_rand_base64_48
BCRYPT_ROUNDS=12

# 📊 Queue and Concurrency Configuration
# Queue settings
QUEUE_MAX_SIZE=10000
QUEUE_VISIBILITY_TIMEOUT=300
QUEUE_MAX_RETRIES=3

# Concurrency control
DEFAULT_USER_CONCURRENT_LIMIT=3
GLOBAL_CONCURRENT_LIMIT=50
DEFAULT_DAILY_QUOTA=1000

# Worker configuration
WORKER_HEARTBEAT_INTERVAL=30

# Rate limiting
RATE_LIMIT_ENABLED=true
DEFAULT_RATE_LIMIT=100

# 🤖 Smart Assistant Configuration
# Overall timeout (LLM + multi-turn tool calls); aborts and notifies user on timeout (default: 120 seconds)
ASSISTANT_TIMEOUT_SECONDS=120

# 📁 File Upload Configuration
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=uploads

# 📊 Monitoring Configuration
METRICS_ENABLED=true
HEALTH_CHECK_INTERVAL=60

# ==================== Real-Time Quotes Ingestion Service Configuration ====================
# 📈 Real-time quotes ingestion service
# Fetches full-market real-time quotes from data sources (Tushare/AKShare) and stores them in MongoDB
# Used for frontend quote display, stock watchlists, AI analysis, etc.

# Enable/disable real-time quotes ingestion service
QUOTES_INGEST_ENABLED=true

# Quotes collection interval (seconds)
# - Free tier recommendation: 300-600 seconds (5-10 minutes) to avoid exceeding Tushare rt_k rate limits
# - Paid tier recommendation: 5-60 seconds to make full use of paid Tushare permissions
# - Default: 360 seconds (6 minutes), collecting 10 times per hour
QUOTES_INGEST_INTERVAL_SECONDS=360

# Enable interface rotation mechanism
# - true: Rotate among Tushare rt_k → AKShare Eastmoney → AKShare Sina Finance
# - false: Use default priority order (Tushare > AKShare)
# Advantage: Prevents rate limiting or IP blocking on a single interface, improving service reliability
QUOTES_ROTATION_ENABLED=true

# Hourly call limit for Tushare rt_k interface
# - Free users: 2 calls (official Tushare limit of 2 calls per hour)
# - Paid users: Can be set higher (e.g., 1000) according to your account permissions
# When the limit is exceeded, Tushare is automatically skipped in favor of AKShare fallback interfaces
QUOTES_TUSHARE_HOURLY_LIMIT=2

# Automatically detect Tushare rt_k interface permissions
# - true: Automatically detects permissions on first run; paid users will receive high-frequency collection recommendations
# - false: Do not detect; run strictly as configured
QUOTES_AUTO_DETECT_TUSHARE_PERMISSION=true

# Off-hours / startup fallback backfill (populates the latest closing snapshot)
QUOTES_BACKFILL_ON_STARTUP=true
QUOTES_BACKFILL_ON_OFFHOURS=true

# ==================== Data Synchronization Service Configuration ====================

# 🔄 Tushare Unified Data Sync Configuration
# Enable Tushare unified data synchronization
TUSHARE_UNIFIED_ENABLED=true

# Basic info sync (Daily at 02:00 AM)
TUSHARE_BASIC_INFO_SYNC_ENABLED=true
TUSHARE_BASIC_INFO_SYNC_CRON="0 2 * * *"

# Real-time quotes sync (Every 5 minutes during trading hours)
TUSHARE_QUOTES_SYNC_ENABLED=true
TUSHARE_QUOTES_SYNC_CRON="*/5 9-15 * * 1-5"

# Historical data sync (Weekdays at 18:00)
TUSHARE_HISTORICAL_SYNC_ENABLED=true
TUSHARE_HISTORICAL_SYNC_CRON="0 18 * * 1-5"

# Financial data sync (Sundays at 03:00 AM)
TUSHARE_FINANCIAL_SYNC_ENABLED=true
TUSHARE_FINANCIAL_SYNC_CRON="0 3 * * 0"

# Watchlist A-share data sync (Historical + financial data, trading days at 19:00)
FAVORITES_DATA_SYNC_ENABLED=true
FAVORITES_DATA_SYNC_CRON="0 19 * * 1-5"

# Status check (Hourly)
TUSHARE_STATUS_CHECK_ENABLED=true
TUSHARE_STATUS_CHECK_CRON="0 * * * *"

# 🚀 Tushare Data Initialization Configuration
# Number of historical days to fetch on initial deployment (default: 1 year; >=3650 syncs full history)
TUSHARE_INIT_HISTORICAL_DAYS=365
# Initialization batch size
TUSHARE_INIT_BATCH_SIZE=100
# Whether to automatically check and initialize data on application startup
TUSHARE_INIT_AUTO_START=false

# 🔧 Tushare Rate Limit Configuration
# Points tier: free (100 calls/min), basic (200), standard (400), premium (600), vip (800)
TUSHARE_TIER=standard
# Safety margin (0-1); effective limit is a fraction of the theoretical limit (0.8 recommended to avoid burst limit errors)
TUSHARE_RATE_LIMIT_SAFETY_MARGIN=0.8

# 🔄 AKShare Unified Data Sync Configuration
# Enable AKShare unified data synchronization
AKSHARE_UNIFIED_ENABLED=true

# Basic info sync (Daily at 03:00 AM)
AKSHARE_BASIC_INFO_SYNC_ENABLED=false
AKSHARE_BASIC_INFO_SYNC_CRON="0 3 * * *"

# Real-time quotes sync (Every 30 minutes during trading hours to avoid rate limiting)
AKSHARE_QUOTES_SYNC_ENABLED=false
AKSHARE_QUOTES_SYNC_CRON="*/30 9-15 * * 1-5"

# Historical data sync (Weekdays at 18:00)
AKSHARE_HISTORICAL_SYNC_ENABLED=false
AKSHARE_HISTORICAL_SYNC_CRON="0 18 * * 1-5"

# Financial data sync (Sundays at 04:00 AM)
AKSHARE_FINANCIAL_SYNC_ENABLED=false
AKSHARE_FINANCIAL_SYNC_CRON="0 4 * * 0"

# Status check (Every hour at minute 30)
AKSHARE_STATUS_CHECK_ENABLED=false
AKSHARE_STATUS_CHECK_CRON="30 * * * *"

# 🚀 AKShare Data Initialization Configuration
# Number of historical days to fetch on initial deployment (default: 1 year)
AKSHARE_INIT_HISTORICAL_DAYS=365
# Initialization batch size
AKSHARE_INIT_BATCH_SIZE=100
# Whether to automatically check and initialize data on application startup
AKSHARE_INIT_AUTO_START=false

# ==================== 📊 Analyst Data Fetching Configuration ====================

# 🔍 Market Analyst Data Range Configuration
# Lookback days for market analysis (used for technical analysis; requires sufficient historical data to compute indicators)
# Recommended values:
#   - Quick analysis: 10-15 days (basic indicators: MA5, MA10)
#   - Standard analysis: 30 days (daily usage: MA20, MACD, RSI, BOLL)
#   - Deep analysis: 60 days (recommended, covers MA60 and all common technical indicators) ⭐
#   - Comprehensive analysis: 90-365 days (long-term trend analysis)
# Note: Computing MA60 requires at least 60 days of data
MARKET_ANALYST_LOOKBACK_DAYS=365

# 📈 Fundamental Analyst Data Range Configuration
# Note: Fundamental analysis always fetches 10 days of data (to ensure data availability) but only uses the most recent 2 days
# No configuration required; already optimized internally in code

# ==================== 📊 BaoStock Unified Data Sync Configuration ====================

# 🔧 BaoStock Unified Data Sync Master Switch
# Set to true to enable the BaoStock data source, or false to disable
BAOSTOCK_UNIFIED_ENABLED=true

# 📋 Basic Info Sync (Daily at 04:00 AM)
# Syncs stock codes, names, listing dates, and other basic information
BAOSTOCK_BASIC_INFO_SYNC_ENABLED=false
BAOSTOCK_BASIC_INFO_SYNC_CRON="0 4 * * *"

# 📈 Daily K-Line Sync (Weekdays after market close at 18:00)
# Note: BaoStock does not support real-time quotes; this task syncs daily K-line data for the latest trading day
BAOSTOCK_DAILY_QUOTES_SYNC_ENABLED=false
BAOSTOCK_DAILY_QUOTES_SYNC_CRON="0 18 * * 1-5"

# 📊 Historical Data Sync (Weekdays at 18:00)
# Syncs historical K-line data for technical analysis
BAOSTOCK_HISTORICAL_SYNC_ENABLED=false
BAOSTOCK_HISTORICAL_SYNC_CRON="0 18 * * 1-5"

# 🔍 Status Check (Every hour at minute 45)
# Checks BaoStock service status and data integrity
BAOSTOCK_STATUS_CHECK_ENABLED=false
BAOSTOCK_STATUS_CHECK_CRON="45 * * * *"

# 🚀 BaoStock Data Initialization Configuration
# Number of historical days to fetch on initial deployment (default: 1 year)
BAOSTOCK_INIT_HISTORICAL_DAYS=365
# Initialization batch size (smaller batches recommended for BaoStock)
BAOSTOCK_INIT_BATCH_SIZE=50
# Whether to automatically check and initialize data on application startup
BAOSTOCK_INIT_AUTO_START=false

# 📝 Logging Configuration
LOG_FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s"
LOG_FILE=logs/tradingagents.log

# ===== Docker Deployment Notes =====
# When deploying with Docker, update the following settings:
# 1. Enable databases:
#    MONGODB_ENABLED=true
#    REDIS_ENABLED=true
# 2. Update hostnames:
#    MONGODB_HOST=mongodb
#    REDIS_HOST=redis
# 3. Start services:
#    docker-compose up -d
# 4. Access URLs:
#    - Web Application: http://localhost:8501
#    - API Service: http://localhost:8000

# ===== Stock Basic Info Sync Schedule Configuration =====
# Enable/disable daily synchronization
SYNC_STOCK_BASICS_ENABLED=true
# Schedule using a CRON expression (takes precedence). Example: 07:00 AM daily
# SYNC_STOCK_BASICS_CRON=0 7 * * *
# Or use a simple 24-hour time (HH:MM). Example: 06:30
SYNC_STOCK_BASICS_TIME=06:30
# Timezone
TIMEZONE=Asia/Shanghai

#    - Redis Admin UI: http://localhost:8081
#    - MongoDB Admin UI: http://localhost:8082


# ===== Backend Settings (pydantic) missing keys (preferred) =====
# Note: The keys below are the canonical fields in app/core/config.py; prefer using these keys.
# API_HOST/API_PORT/API_DEBUG are legacy keys that remain supported for backward compatibility but are deprecated; use DEBUG/HOST/PORT instead (legacy keys will be removed in a future release).
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Skip PRO License check in development environment (only takes effect when DEBUG=true)
# When enabled, all PRO features (workflows, advanced courses, etc.) are unlocked for the currently logged-in user to facilitate local development and testing.
# In production (DEBUG=false), this setting has no effect even if set to true, ensuring license verification cannot be bypassed.
# LICENSE_SKIP_PRO_CHECK=false

# 🔧 Worker Service Port (FastAPI + Uvicorn)
# Worker is the background task processing service; default port is 8001
WORKER_PORT=8001

# ===== Nginx Settings =====
# Nginx frontend service port (default: 80)
NGINX_PORT=80

# Connection Pool & Retry Settings (Mongo/Redis)
MONGO_MAX_CONNECTIONS=100
MONGO_MIN_CONNECTIONS=10
# MongoDB timeout parameters (milliseconds) - tuned for handling large volumes of historical data
# connectTimeoutMS: Connection timeout (default: 30s, previously 10s)
# socketTimeoutMS: Socket timeout (default: 60s, previously 20s)
# serverSelectionTimeoutMS: Server selection timeout (default: 5s)
MONGO_CONNECT_TIMEOUT_MS=30000
MONGO_SOCKET_TIMEOUT_MS=60000
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
REDIS_MAX_CONNECTIONS=20
REDIS_RETRY_ON_TIMEOUT=true

# Log level (defaults to INFO if unset)
LOG_LEVEL=INFO

# Cache & Session TTLs
CACHE_TTL=3600
SCREENING_CACHE_TTL=1800
SESSION_EXPIRE_HOURS=24

 TA_USE_APP_CACHE=true


 # ===== Memory and Cache Configuration =====
# 🧠 Memory feature toggle (enabled by default)
# Set to false to disable vector database memory features
MEMORY_ENABLED=true

# 🗄️ Vector Database Backend Configuration
# Options:
#   - mongodb: MongoDB vector storage (default; unified storage with business data, client-side cosine similarity)
#   - qdrant: Qdrant vector database (optional fallback; server mode suited for large data volumes)
# Notes:
#   - MongoDB mode: Vectors and business data are stored together in MongoDB, reducing infrastructure maintenance
#   - MongoDB mode: Similarity computation is performed in Python (numpy cosine), suitable for small-to-medium scale (< 10K entries)
#   - Qdrant mode: Rust-based vector database suited for large-scale datasets; requires standalone deployment
VECTOR_STORE_BACKEND=mongodb

# Qdrant data directory (only used when VECTOR_STORE_BACKEND=qdrant)
QDRANT_DATA_DIR=./data/qdrant

# ===== mem0 Unified Memory Layer Configuration =====
# mem0 reuses the MongoDB and DeepSeek/DashScope configurations above
# The settings below are optional mem0-specific overrides (usually no modification needed)

# mem0 memory feature master switch (enabled by default; set to false to disable completely)
MEM0_ENABLED=true

# ==================== JD Cloud Partner Edition Configuration ====================
# The JD Cloud Partner Edition injects configuration via environment variables, so users do not need to configure LLMs or data sources in the UI
# Set JDYUN_MODE=true to enable JD Cloud Partner Edition mode
JDYUN_MODE=false

# JD Cloud model service endpoint (OpenAI-compatible API)
OPENAI_API_BASE=https://modelservice.jdcloud.com/v1

# JD Cloud API Key
OPENAI_API_KEY=

# Default chat model (options: GLM-5 / GLM-5.1 / GLM-5.2 / DeepSeek-V4-Flash)
OPENAI_MODEL=GLM-5

# Embedding model (used for the memory system; defaults to Qwen3-Embedding-8B)
EMBEDDING_MODEL=Qwen3-Embedding-8B
EMBEDDING_API_BASE=https://modelservice.jdcloud.com/v1
EMBEDDING_API_KEY=

# Tushare data source token (centrally provided by JD Cloud)
TUSHARE_TOKEN=

# ==================== Embedding Model Configuration (Optional, for non-JD Cloud mode) ====================
# Vector embedding model used for the memory system (mem0); if unset, uses the Embedding model configured in the UI
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_BASE=https://api.openai.com/v1
# EMBEDDING_API_KEY=
